{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "noEmit": true,
    "module": "esnext",
    "target": "esnext",
    "types": ["node"],

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,

    "paths": { "#/*": ["./src/*"], "#/test/*": ["./test/*"] }
  },
  // The library is type-checked here, with every strictness guard on: the
  // option and data layers here are statically shaped, so
  // noPropertyAccessFromIndexSignature and noUncheckedIndexedAccess are
  // load-bearing. The test suite has its own project (test/tsconfig.json)
  // because a parsed XML tree's keys are only known at runtime, which
  // those two guards cannot accommodate.
  //
  // bench/ is included here rather than left out: it drives the public API
  // with statically-typed options, so the same guards apply and there is no
  // reason for a second untype-checked island in the repo.
  "include": ["src/**/*.ts", "bench/**/*.ts"]
}
