{
  // Workspace-root TypeScript project.
  //
  // Covers the repo's own TypeScript — currently just vite.config.ts. Package
  // sources are deliberately NOT included here: each package type-checks under
  // its own project so it can pick its own `paths` and `include`, and because a
  // single root project spanning src/ and test/ would force one set of strictness
  // guards on both. The library keeps noPropertyAccessFromIndexSignature and
  // noUncheckedIndexedAccess; the test suite relaxes both, because a parsed XML
  // tree's keys are only known at runtime.
  //
  // See packages/parser/tsconfig.json and packages/parser/test/tsconfig.json.
  "extends": "./tsconfig.shared.json",
  "include": ["*.ts"]
}
