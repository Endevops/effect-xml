{
  "name": "@endevops/path-expression-matcher",
  "version": "1.6.2",
  "description": "Efficient path tracking and pattern matching for XML/JSON parsers. Fork of path-expression-matcher, with static types across the source tree, a generic expression payload, and a typed test suite.",
  "keywords": [
    "fast",
    "html",
    "json",
    "matcher",
    "parser",
    "path",
    "pattern",
    "selector",
    "xml",
    "xpath",
    "yaml"
  ],
  "homepage": "https://github.com/Endevops/effect-xml/tree/main/packages/path-expression-matcher#readme",
  "bugs": {
    "url": "https://github.com/Endevops/effect-xml/issues"
  },
  "license": "MIT",
  "author": "Endevops",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Endevops/effect-xml.git",
    "directory": "packages/path-expression-matcher"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "imports": {
    "#/*": "./src/*",
    "#/test/*": "./test/*"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp pack"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
