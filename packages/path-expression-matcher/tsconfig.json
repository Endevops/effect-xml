// The library is type-checked here, with every strictness guard on: this
// package's whole job is to model a path as data, so the shapes it hands back
// — segments, path nodes, snapshots — are the product, and
// noPropertyAccessFromIndexSignature and noUncheckedIndexedAccess are
// load-bearing on them. The test suite has its own project
// (test/tsconfig.json) because it reads `matcher.path[0]` and other
// positionally-indexed state, which those guards would turn into a null-check
// on every assertion.
//
// `paths` is declared here and not in tsconfig.shared.json: paths are resolved
// relative to the config that declares them, so the `#/*` subpath imports have
// to anchor to this package's own directories.
{
  "extends": "../../tsconfig.shared.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": { "paths": { "#/*": ["./src/*"], "#/test/*": ["./test/*"] } }
}
