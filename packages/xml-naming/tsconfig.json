// The library is type-checked here, with every strictness guard on: this
// package is a pure function library with a fully static surface, so
// noPropertyAccessFromIndexSignature and noUncheckedIndexedAccess are
// load-bearing and cost nothing. The test suite has its own project
// (test/tsconfig.json) because it feeds deliberately malformed input to the
// validators, which noUncheckedIndexedAccess would turn into a null-check on
// every character-level assertion.
//
// bench/ is included here rather than left out: it drives the public API with
// statically-typed options, so the same guards apply.
//
// `paths` is declared here and not in tsconfig.shared.json: paths are resolved
// relative to the config that declares them, so the `#/*` subpath imports have
// to anchor to this package's own directories.
{
  "extends": "../../tsconfig.shared.json",
  "include": ["src/**/*.ts", "bench/**/*.ts"],
  "compilerOptions": { "paths": { "#/*": ["./src/*"], "#/test/*": ["./test/*"], "#/bench/*": ["./bench/*"] } }
}
