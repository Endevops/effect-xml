// The library is type-checked here, with every strictness guard on: the
// builder's whole job is walking a dynamically-shaped input object, so the
// guards are what stop a mistyped option or a missed `undefined` from
// producing malformed XML. The test suite has its own project
// (test/tsconfig.json) because it feeds deliberately malformed input —
// unpaired tags, entities, hostile comments — through the same dynamic
// shape, which noUncheckedIndexedAccess would turn into a null-check on
// every assertion.
//
// `paths` is declared here and not in tsconfig.shared.json: paths are resolved
// relative to the config that declares them, so the `#/*` subpath imports have
// to anchor to this package's own directories.
{
  "extends": "../../tsconfig.shared.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": { "paths": { "#/*": ["./src/*"], "#/test/*": ["./test/*"] } }
}
