{
  "name": "@endevops/builder",
  "version": "0.0.0",
  "description": "XML builders — builds XML from a JavaScript object, plus the base classes and the compact object builder that turn XML into a JavaScript object. Merged into one package from the former @endevops/xml-builder, @endevops/base-output-builder and @endevops/compact-builder packages.",
  "keywords": [
    "builder",
    "fast",
    "j2x",
    "json",
    "json2xml",
    "output-builder",
    "xml",
    "xml-builder"
  ],
  "homepage": "https://github.com/Endevops/effect-xml/tree/master/packages/builder#readme",
  "bugs": {
    "url": "https://github.com/Endevops/effect-xml/issues"
  },
  "license": "MIT",
  "author": "Endevops",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Endevops/effect-xml.git",
    "directory": "packages/builder"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "imports": {
    "#/*": "./src/*",
    "#/test/*": "./test/*"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp pack"
  },
  "dependencies": {
    "@endevops/common-xml": "workspace:^"
  },
  "devDependencies": {
    "fast-xml-parser": "^5.11.1",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
