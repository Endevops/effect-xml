{
  "name": "@endevops/xml-builder",
  "version": "1.3.1",
  "description": "Build XML from JSON without C/C++ based libraries. Fork of fast-xml-builder, with static types across the source tree and a typed test suite.",
  "keywords": [
    "builder",
    "fast",
    "js2xml",
    "json",
    "json2xml",
    "parser",
    "xml",
    "xml-builder"
  ],
  "homepage": "https://github.com/Endevops/effect-xml/tree/master/packages/builder#readme",
  "bugs": {
    "url": "https://github.com/Endevops/effect-xml/issues"
  },
  "license": "MIT",
  "author": "Endevops",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Endevops/effect-xml.git",
    "directory": "packages/builder"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "imports": {
    "#/*": "./src/*",
    "#/test/*": "./test/*"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp pack"
  },
  "dependencies": {
    "@endevops/path-expression-matcher": "workspace:^",
    "@endevops/xml-naming": "workspace:^"
  },
  "devDependencies": {
    "@endevops/entities": "workspace:^",
    "fast-xml-parser": "^5.11.1",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
