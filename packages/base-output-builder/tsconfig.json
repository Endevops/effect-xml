// The library is type-checked here, with every strictness guard on: this
// package is a set of abstract contracts and per-value transforms, so the
// types ARE the product — noPropertyAccessFromIndexSignature and
// noUncheckedIndexedAccess are load-bearing on the registry's name lookup.
// The test suite has its own project (test/tsconfig.json) because it asserts
// on thrown messages and index into parser lists, which those guards would
// turn into null-checks at every call site.
//
// `paths` is declared here and not in tsconfig.shared.json: paths are resolved
// relative to the config that declares them, so the `#/*` subpath imports have
// to anchor to this package's own directories.
{
  "extends": "../../tsconfig.shared.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": { "paths": { "#/*": ["./src/*"], "#/test/*": ["./test/*"] } }
}
