{
  "name": "@endevops/effect-xml-codec",
  "version": "1.0.0-effect.2",
  "description": "A round-trip Effect Schema codec for XML. Derives an XML representation from any Effect Schema and reads it back, with attributes as `@`-prefixed fields.",
  "keywords": [
    "codec",
    "effect",
    "effect-schema",
    "xml",
    "xml-codec",
    "xml-parser",
    "xml-serialization"
  ],
  "homepage": "https://github.com/Endevops/effect-xml/tree/master/packages/effect-xml-codec#readme",
  "bugs": {
    "url": "https://github.com/Endevops/effect-xml/issues"
  },
  "license": "MIT",
  "author": "Endevops",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Endevops/effect-xml.git",
    "directory": "packages/effect-xml-codec"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.{spec,test}.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*",
    "#/test/*": "./test/*"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp pack"
  },
  "dependencies": {
    "@endevops/common-xml": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@effect/vitest": "^4.0.0",
    "effect": "catalog:",
    "publint": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
