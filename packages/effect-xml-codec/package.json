{
  "name": "@endevops/effect-codec-xml",
  "version": "0.1.0-effect.1",
  "description": "A round-trip Effect Schema codec for XML, with the entity decoder and XML name validators it reads documents with. Derives an XML representation from any Effect Schema and reads it back, with attributes as `@`-prefixed fields.",
  "keywords": [
    "codec",
    "decode",
    "effect",
    "effect-schema",
    "entities",
    "entity-decoder",
    "ncname",
    "nmtoken",
    "qname",
    "xml",
    "xml-codec",
    "xml-naming",
    "xml-parser",
    "xml-serialization"
  ],
  "homepage": "https://github.com/Endevops/effect-xml/tree/master/packages/effect-xml-codec#readme",
  "bugs": {
    "url": "https://github.com/Endevops/effect-xml/issues"
  },
  "license": "MIT",
  "author": "Endevops",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Endevops/effect-xml.git",
    "directory": "packages/effect-xml-codec"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.{spec,test}.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*",
    "#/test/*": "./test/*"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp pack"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "publint": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
