// The library is type-checked here, with every strictness guard on: the whole
// surface is a schema-to-XML derivation, so the guards are what stop a
// malformed `XmlValue` or a mistyped render option from producing invalid XML.
// The test suite has its own project (test/tsconfig.json) because it feeds
// deliberately malformed documents — unbalanced tags, stray `<`, hostile
// entities — through the parser, which noUncheckedIndexedAccess would turn
// into a null-check at every character-level assertion.
//
// `paths` is declared here and not in tsconfig.shared.json: paths are resolved
// relative to the config that declares them, so the `#/*` subpath imports have
// to anchor to this package's own directories.
{
  "extends": "../../tsconfig.shared.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": { "paths": { "#/*": ["./src/*"], "#/test/*": ["./test/*"] } }
}
