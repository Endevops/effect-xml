{
  "name": "@endevops/common-xml",
  "version": "0.0.0",
  "description": "Shared XML primitives — entity encoding and decoding, path expression matching, and XML name production validation. Merged into one package from the former @endevops/entities, @endevops/path-expression-matcher and @endevops/xml-naming packages.",
  "keywords": [
    "decode",
    "encode",
    "entities",
    "html",
    "matcher",
    "ncname",
    "ncr",
    "nmtoken",
    "path",
    "pattern",
    "qname",
    "selector",
    "xml",
    "xml-naming",
    "xpath"
  ],
  "homepage": "https://github.com/Endevops/effect-xml/tree/master/packages/common-xml#readme",
  "bugs": {
    "url": "https://github.com/Endevops/effect-xml/issues"
  },
  "license": "MIT",
  "author": "Endevops",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Endevops/effect-xml.git",
    "directory": "packages/common-xml"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "imports": {
    "#/*": "./src/*",
    "#/test/*": "./test/*",
    "#/bench/*": "./bench/*"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp pack"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
