{
  "name": "@endevops/parser",
  "version": "0.0.1",
  "description": "XML parser in pure JavaScript with pluggable output builders and composable value parsers. Fork of @nodable/flexible-xml-parser, with static types across the source tree and a fully typed test suite.",
  "keywords": [
    "buffer",
    "bytes",
    "fast",
    "fast-xml-parser",
    "flexible",
    "html",
    "parser",
    "sax",
    "stream",
    "xml",
    "xml-parser",
    "xml2js",
    "xml2json",
    "xml2xml",
    "xml2yaml"
  ],
  "homepage": "https://github.com/Endevops/effect-xml/tree/master/packages/parser#readme",
  "bugs": {
    "url": "https://github.com/Endevops/effect-xml/issues"
  },
  "license": "MIT",
  "author": "Endevops",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Endevops/effect-xml.git",
    "directory": "packages/parser"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.{spec,test}.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "imports": {
    "#/*": "./src/*",
    "#/test/*": "./test/*"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp pack"
  },
  "dependencies": {
    "@endevops/builder": "workspace:^",
    "@endevops/common-xml": "workspace:^",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "publint": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
