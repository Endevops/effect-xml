{
  // The library is type-checked here, with every strictness guard on: the
  // option and data layers here are statically shaped, so
  // noPropertyAccessFromIndexSignature and noUncheckedIndexedAccess are
  // load-bearing. The test suite has its own project (test/tsconfig.json)
  // because a parsed XML tree's keys are only known at runtime, which
  // those two guards cannot accommodate.
  //
  // bench/ is included here rather than left out: it drives the public API
  // with statically-typed options, so the same guards apply and there is no
  // reason for a second untype-checked island in the repo.
  //
  // `paths` is declared here and not in tsconfig.shared.json: paths are resolved
  // relative to the config that declares them, so the `#/*` subpath imports
  // have to anchor to this package's own directories.
  "extends": "../../tsconfig.shared.json",
  "include": ["src/**/*.ts", "bench/**/*.ts"],
  "compilerOptions": { "paths": { "#/*": ["./src/*"], "#/test/*": ["./test/*"] } }
}
