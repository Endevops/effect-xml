{
  "name": "@endevops/entities",
  "version": "2.2.0",
  "description": "XML and HTML entity encoding and decoding, with typed hooks and expansion limits. Fork of @nodable/entities, with static types across the source tree and a typed test suite.",
  "keywords": [
    "decode",
    "encode",
    "entities",
    "html",
    "ncr",
    "xml",
    "xml-parser"
  ],
  "homepage": "https://github.com/Endevops/effect-xml/tree/main/packages/entities#readme",
  "bugs": {
    "url": "https://github.com/Endevops/effect-xml/issues"
  },
  "license": "MIT",
  "author": "Endevops",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Endevops/effect-xml.git",
    "directory": "packages/entities"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "imports": {
    "#/*": "./src/*",
    "#/test/*": "./test/*"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp pack"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
