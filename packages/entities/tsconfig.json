// The library is type-checked here, with every strictness guard on. This
// package's whole product is a set of contracts — hook signatures, tier
// accounting, expansion limits — where a type that is one notch too wide lets
// a caller register an entity that silently bypasses a limit. The guards are
// what stop that. The test suite has its own project (test/tsconfig.json)
// because it reaches into the decoder's internals and asserts on thrown
// messages, which those guards would turn into null-checks at every site.
//
// `paths` is declared here and not in tsconfig.shared.json: paths are resolved
// relative to the config that declares them, so the `#/*` subpath imports have
// to anchor to this package's own directories.
{
  "extends": "../../tsconfig.shared.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": { "paths": { "#/*": ["./src/*"], "#/test/*": ["./test/*"] } }
}
