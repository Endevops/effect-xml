// The library is type-checked here, with every strictness guard on: the whole
// job of this builder is deciding a value's shape — string, object, or array —
// so the guards are what stop a mistyped option or an un-narrowed node from
// producing malformed output. The test suite has its own project
// (test/tsconfig.json) because it drives the builder through a hand-written
// parser-options object and asserts on the resulting dynamic structure, which
// those guards would turn into a null-check at every call site.
//
// `paths` is declared here and not in tsconfig.shared.json: paths are resolved
// relative to the config that declares them, so the `#/*` subpath imports have
// to anchor to this package's own directories.
{
  "extends": "../../tsconfig.shared.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": { "paths": { "#/*": ["./src/*"], "#/test/*": ["./test/*"] } }
}
