// Test-suite type-check configuration.
//
// Extends the package tsconfig so the specs stay under the same `strict`
// family as the library, with the two index-signature guards relaxed. Both are
// load-bearing for src/ — the builder indexes into an attribute bag and a path
// stack — and hostile to tests, which drive the builder with a hand-written
// parser-options object and then assert on the resulting dynamic structure, so
// every access would need a guard.
//
// The library keeps both guards (see ../tsconfig.json, which covers src/).
// Only the test tree opts out.
{
  "extends": "../tsconfig.json",
  "compilerOptions": { "noPropertyAccessFromIndexSignature": false, "noUncheckedIndexedAccess": false },
  "include": ["./**/*.ts"]
}
