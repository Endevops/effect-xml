{
  "name": "@endevops/effect-xml",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the Endevops XML packages. Holds the toolchain and the shared lint, format, and TypeScript configuration; each publishable package lives in packages/.",
  "keywords": [
    "effect-xml",
    "monorepo",
    "xml",
    "xml-parser"
  ],
  "homepage": "https://github.com/Endevops/flexible-xml-parser-effect#readme",
  "bugs": {
    "url": "https://github.com/Endevops/flexible-xml-parser-effect/issues"
  },
  "license": "MIT",
  "author": "Endevops",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Endevops/flexible-xml-parser-effect.git"
  },
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "check": "vp check",
    "dev": "vp run -r --parallel dev",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "prepare": "vp config",
    "test": "vp test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.6.0"
}
