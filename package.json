{
  "name": "@endevops/effect-xml",
  "version": "0.1.0-effect.1",
  "private": true,
  "description": "Monorepo for the Endevops XML packages. Holds the toolchain and the shared lint, format, and TypeScript configuration; each publishable package lives in packages/.",
  "keywords": [
    "effect-xml",
    "monorepo",
    "xml",
    "xml-parser"
  ],
  "homepage": "https://github.com/Endevops/effect-xml#readme",
  "bugs": {
    "url": "https://github.com/Endevops/effect-xml/issues"
  },
  "license": "MIT",
  "author": "Endevops",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Endevops/effect-xml.git"
  },
  "type": "module",
  "scripts": {
    "bench": "vp run -r bench",
    "build": "vp run -r build",
    "check": "vp check",
    "dev": "vp run -r --parallel dev",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "prepack": "pnpm build",
    "prepare": "effect-tsgo patch --oxlint && vp config",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "test": "vp test",
    "version:sync": "node scripts/release/sync-versions.mjs"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.46.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "5.0.1",
    "fallow": "^3.30.0",
    "semantic-release": "25.0.9",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.8.0"
}
