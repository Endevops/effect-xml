{
  "name": "@endevops/flexible-xml-parser-effect",
  "version": "0.0.0",
  "description": "Fork of the fastest and fully customizable XML parser in pure JS with fully customizable ouput, based on (@nodable/flexible-xml-parser (f51ecad55027aebae1b89740479e9ec4cbdd6e0f))",
  "keywords": [
    "buffer",
    "bytes",
    "fast",
    "fast-xml-parser",
    "flexible",
    "html",
    "parser",
    "path-expression-matcher",
    "sax",
    "stream",
    "xml",
    "xml-naming",
    "xml-parser",
    "xml2js",
    "xml2json",
    "xml2xml",
    "xml2yaml"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#/test/*": "./test/*",
    "#/assets/*": "./assets/*"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "prepare": "vp config"
  },
  "dependencies": {
    "@nodable/base-output-builder": "^2.0.0",
    "@nodable/compact-builder": "^2.0.0",
    "path-expression-matcher": "^1.6.2",
    "xml-naming": "^0.3.0"
  },
  "devDependencies": {
    "@nodable/entities": "^2.2.0",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@12.6.0"
}
